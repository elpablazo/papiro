# Copy to .env and change the password. Never commit .env.
PAPIRO_ADMIN_USER=admin
PAPIRO_ADMIN_PASSWORD=change-me-please

# OCR languages (must be installed in the image; see OCR_LANGS in the Dockerfile)
# PAPIRO_OCR_LANGS=eng

# Optional: LLM classification and summaries (sends document text to the provider)
# PAPIRO_LLM_API_KEY=
# PAPIRO_LLM_MODEL=claude-haiku-5-5

# Optional: email ingestion (IMAP over TLS)
# PAPIRO_IMAP_HOST=imap.example.com
# PAPIRO_IMAP_USER=
# PAPIRO_IMAP_PASSWORD=
